global
    log stdout format raw daemon "${LOG_LEVEL}"
    maxconn 4000

defaults
    mode http
    log global
    option httplog
    option http-server-close
    timeout connect 10s
    timeout client 30s
    timeout server 30s
    timeout http-request 10s

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}

    # Allow only POST requests to restart the explicitly authorized container.
    http-request deny unless METH_POST
    http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/containers/ship-demo-service/restart$ }
    http-request deny

    default_backend dockerbackend
