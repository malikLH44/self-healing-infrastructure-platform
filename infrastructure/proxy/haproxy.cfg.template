global
    log stdout format raw daemon "${LOG_LEVEL}"
    maxconn 4000

defaults
    mode http
    log global
    option httplog
    option http-server-close
    timeout connect 10s
    timeout client 30s
    timeout server 30s
    timeout http-request 10s

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}

    # Allow POST only for the authorized demo container restart.
    acl restart_method method POST
    acl restart_path path_reg -i ^(/v[0-9.]+)?/containers/ship-demo-service/restart$

    # Allow GET only for one-shot statistics of the demo container.
    acl stats_method method GET
    acl stats_path path_reg -i ^(/v[0-9.]+)?/containers/ship-demo-service/stats$
    acl stats_stream_false url_param(stream) -m str false

    http-request allow if restart_method restart_path
    http-request allow if stats_method stats_path stats_stream_false
    http-request deny

    default_backend dockerbackend
