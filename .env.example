# Application
SHIP_ENV=development
SHIP_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=ship
POSTGRES_USER=ship_app
SHIP_DB_PASSWORD=CHANGE_ME_LOCALLY
# Backend API
SHIP_API_HOST=0.0.0.0
SHIP_API_PORT=8000

# Monitoring
SHIP_MONITORING_INTERVAL_SECONDS=15
SHIP_HEALTHCHECK_TIMEOUT_SECONDS=5

# Remediation safety
SHIP_MAX_RETRIES=3
SHIP_REMEDIATION_COOLDOWN_SECONDS=60
SHIP_RECOVERY_TIMEOUT_SECONDS=60

# Authentication
SHIP_JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
SHIP_ADMIN_USERNAME=admin
SHIP_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD
SHIP_ACCESS_TOKEN_EXPIRE_MINUTES=30